# Reference only: export these variables in your shell; .env is not auto-loaded.
HOST=127.0.0.1
PORT=8080
APP_ENV=development
DATABASE_URL=jdbc:h2:file:./data/community;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE
DATABASE_USER=sa
# DATABASE_PASSWORD must be supplied for PostgreSQL / Docker Compose.
# BOOTSTRAP_CLIENT_NAME, BOOTSTRAP_EMAIL, BOOTSTRAP_PASSWORD: first client setup.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=community@example.test
# SMTP_STARTTLS=false
# Production requires SMTP_STARTTLS=true, SMTP_USER, and SMTP_PASSWORD.
