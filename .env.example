# Copy to .env and set these once before using Docker Compose.
# Keep both values stable across container restarts.
DATABASE_PASSWORD=
API_ENCRYPTION_KEY=

# Optional external hardware and video providers; leave unset for local tests.
# LOCKER_PROVIDER_BASE_URL=https://locker-provider.example
# LOCKER_PROVIDER_TOKEN=
# CAMERA_PROVIDER_BASE_URL=https://camera-provider.example
# CAMERA_PROVIDER_TOKEN=

# The bootstrap command reads these from the calling shell when passed with -e.
# BOOTSTRAP_CLIENT_NAME=Condominio Demo
# BOOTSTRAP_EMAIL=admin@example.test
# BOOTSTRAP_PASSWORD=

# For a local Java process, export APP_ENV, DATABASE_URL, DATABASE_USER,
# DATABASE_PASSWORD, API_ENCRYPTION_KEY and SMTP_* into that process.
