# Copy to .env and set these once before using Docker Compose.
# Keep both values stable across container restarts.
DATABASE_PASSWORD=
API_ENCRYPTION_KEY=

# The bootstrap command reads these from the calling shell when passed with -e.
# BOOTSTRAP_CLIENT_NAME=Condominio Demo
# BOOTSTRAP_EMAIL=admin@example.test
# BOOTSTRAP_PASSWORD=

# SMTP_FROM=community@example.test
# SMTP_STARTTLS=false
# Production requires SMTP_STARTTLS=true, SMTP_USER, and SMTP_PASSWORD.
